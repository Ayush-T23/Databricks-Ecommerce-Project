{
  "datasets": [
    {
      "name": "d63f8c46",
      "displayName": "gld_fact_order_items",
      "queryLines": [
        "SELECT\n",
        "  transaction_date,\n",
        "  SUM(net_amount) AS revenue\n",
        "FROM\n",
        "  gld_fact_order_items\n",
        "GROUP BY\n",
        "  transaction_date\n",
        "ORDER BY\n",
        "  transaction_date;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "c46a8a48",
      "displayName": "Total Revenue",
      "queryLines": [
        "SELECT\n",
        "  SUM(net_amount) AS total_revenue\n",
        "FROM\n",
        "  gld_fact_order_items;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "e9fd197d",
      "displayName": "Total Orders",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT transaction_id) AS total_orders\n",
        "FROM\n",
        "  gld_fact_order_items;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "2a2fb91b",
      "displayName": "Average Order Value",
      "queryLines": [
        "SELECT\n",
        "  SUM(net_amount) / COUNT(DISTINCT transaction_id) AS avg_order_value\n",
        "FROM\n",
        "  gld_fact_order_items;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "62923e5f",
      "displayName": "Top Products by Name",
      "queryLines": [
        "SELECT\n",
        "  CONCAT(p.brand_name, ' - ', p.category_name) AS product_name,\n",
        "  SUM(f.net_amount) AS revenue\n",
        "FROM\n",
        "  gld_fact_order_items f\n",
        "    JOIN gld_dim_products p\n",
        "      ON f.product_id = p.product_id\n",
        "GROUP BY\n",
        "  CONCAT(p.brand_name, ' - ', p.category_name)\n",
        "ORDER BY\n",
        "  revenue DESC\n",
        "LIMIT 10;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "8af3c5ba",
      "displayName": "Revenue by Category",
      "queryLines": [
        "SELECT\n",
        "  p.category_name AS category,\n",
        "  SUM(f.net_amount) AS revenue\n",
        "FROM\n",
        "  gld_fact_order_items f\n",
        "    JOIN gld_dim_products p\n",
        "      ON f.product_id = p.product_id\n",
        "GROUP BY\n",
        "  p.category_name\n",
        "ORDER BY\n",
        "  revenue DESC;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "6ae1f6f5",
      "displayName": "Monthly Revenue",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('month', transaction_date) AS month,\n",
        "  date_format(date_trunc('month', transaction_date), 'MMM yyyy') AS month_label,\n",
        "  SUM(net_amount) AS revenue\n",
        "FROM\n",
        "  ecommerce.gold.gld_fact_order_items\n",
        "GROUP BY\n",
        "  month,\n",
        "  month_label\n",
        "ORDER BY\n",
        "  month;"
      ]
    },
    {
      "name": "bec512c0",
      "displayName": "Total Customers",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT customer_id) AS total_customers\n",
        "FROM\n",
        "  gld_fact_order_items;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "adfc9908",
      "displayName": "Revenue by Channel",
      "queryLines": [
        "SELECT\n",
        "  channel,\n",
        "  SUM(net_amount) AS revenue\n",
        "FROM\n",
        "  gld_fact_order_items\n",
        "GROUP BY\n",
        "  channel\n",
        "ORDER BY\n",
        "  revenue DESC;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "f9b2e13d",
      "displayName": "Top Customers by Revenue",
      "queryLines": [
        "SELECT\n",
        "  CONCAT(c.region, ' - ', c.country, ' (', SUBSTRING(c.customer_id, 1, 8), '...)') AS customer_name,\n",
        "  SUM(f.net_amount) AS revenue\n",
        "FROM\n",
        "  gld_fact_order_items f\n",
        "    JOIN gld_dim_customers c\n",
        "      ON f.customer_id = c.customer_id\n",
        "GROUP BY\n",
        "  CONCAT(c.region, ' - ', c.country, ' (', SUBSTRING(c.customer_id, 1, 8), '...)')\n",
        "ORDER BY\n",
        "  revenue DESC\n",
        "LIMIT 10;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "26a78af5",
      "displayName": "Coupon Impact Analysis",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN coupon_flag = 1 THEN 'With Coupon'\n",
        "    ELSE 'Without Coupon'\n",
        "  END AS coupon_usage,\n",
        "  SUM(net_amount) AS revenue,\n",
        "  COUNT(DISTINCT transaction_id) AS orders\n",
        "FROM\n",
        "  gld_fact_order_items\n",
        "GROUP BY\n",
        "  CASE\n",
        "    WHEN coupon_flag = 1 THEN 'With Coupon'\n",
        "    ELSE 'Without Coupon'\n",
        "  END;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "dc69eb78",
      "displayName": "Day of Week Performance",
      "queryLines": [
        "SELECT\n",
        "  date_format(transaction_date, 'EEEE') AS day_of_week,\n",
        "  SUM(net_amount) AS revenue,\n",
        "  COUNT(DISTINCT transaction_id) AS orders\n",
        "FROM\n",
        "  gld_fact_order_items\n",
        "GROUP BY\n",
        "  date_format(transaction_date, 'EEEE')\n",
        "ORDER BY\n",
        "  CASE date_format(transaction_date, 'EEEE')\n",
        "    WHEN 'Monday' THEN 1\n",
        "    WHEN 'Tuesday' THEN 2\n",
        "    WHEN 'Wednesday' THEN 3\n",
        "    WHEN 'Thursday' THEN 4\n",
        "    WHEN 'Friday' THEN 5\n",
        "    WHEN 'Saturday' THEN 6\n",
        "    WHEN 'Sunday' THEN 7\n",
        "  END;"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    }
  ],
